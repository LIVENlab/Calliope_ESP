# ----------------------------
# SINGLE SCENARIOS
# ----------------------------
rule scenario_A_single:
    input:
        model_config="model.yaml",
        overrides='overrides.yaml'
    output:
        nc="results/results_test_scenario_A.nc",
        done="results/results_test_scenario_A.done"
    run:
        inter_logs.info("--- Running scenario_A (single) ---")
        nc_out = output.nc
        done_marker = output.done
        csv_folder = f"results/results_test_scenario_A_csv"
        lp_file = f"results/my_model_A.lp"
        results_ilp = f"results/my_model_A.ilp"

        # Build a single scenario entry (no cost subscenarios)
        from Scripts.functions_scenarios import create_scenario_A
        create_scenario_A(expand_costs=False)

        try:
            model = calliope.examples.spanish_model(
                filename=input.model_config,
                scenario="scenario_A"
            )
            model.build()
            model.backend.verbose_strings()
            model.backend.to_lp(lp_file)
            model.solve()
            model.to_netcdf(nc_out)
            model.to_csv(csv_folder, allow_overwrite=True)

            os.makedirs(os.path.dirname(done_marker), exist_ok=True)
            with open(done_marker, 'w') as f:
                f.write("completed")

            if not os.path.exists(nc_out):
                raise Exception(f"NetCDF file {nc_out} was not created")

            inter_logs.info("Successfully completed scenario_A (single)")

        except Exception as e:
            inter_logs.error(f"file error: {e}")
            inter_logs.error(traceback.format_exc())
            inter_logs.info("Analysing error with Gurobi...")
            if not os.path.exists(lp_file):
                inter_logs.error(f"LP file {lp_file} does not exist, cannot run Gurobi")
                raise
            cmd = ["gurobi_cl", f"ResultFile={results_ilp}", lp_file]
            subprocess.run(cmd, capture_output=True, text=True, check=True)
            inter_logs.info(f"Gurobi report at {results_ilp}")
            # Mark as finished-with-fallback so pipeline can continue
            os.makedirs(os.path.dirname(done_marker), exist_ok=True)
            with open(done_marker, 'w') as f:
                f.write("completed_with_gurobi_fallback")


rule scenario_B_single:
    input:
        model_config="model.yaml",
        overrides='overrides.yaml'
    output:
        nc="results/results_test_scenario_B.nc",
        done="results/results_test_scenario_B.done"
    run:
        inter_logs.info("--- Running scenario_B (single) ---")
        nc_out = output.nc
        done_marker = output.done
        csv_folder = f"results/results_test_scenario_B_csv"
        lp_file = f"results/my_model_B.lp"
        results_ilp = f"results/my_model_B.ilp"

        # path to the existing scenario A result (we don't declare it as an input to avoid forcing A)
        results_A_path = "results/results_test_scenario_A.nc"

        # sanity check: require that the A .nc exists (fail early with a clear message)
        if not os.path.exists(results_A_path):
            raise FileNotFoundError(
                f"Required result from scenario A not found at {results_A_path}. "
                "Place the file there or run scenario_A first."
            )

        from Scripts.functions_scenarios import create_scenario_B
        # create scenario_B using the results from the single-run A
        create_scenario_B(results_A_path, input.overrides, input.overrides, expand_costs=False)

        try:
            model = calliope.examples.spanish_model(
                filename=input.model_config,
                scenario="scenario_B"   # no cost suffix
            )
            model.build()
            model.backend.verbose_strings()
            model.backend.to_lp(lp_file)
            model.solve()
            model.to_netcdf(nc_out)
            model.to_csv(csv_folder, allow_overwrite=True)

            os.makedirs(os.path.dirname(done_marker), exist_ok=True)
            with open(done_marker, 'w') as f:
                f.write("completed")

            if not os.path.exists(nc_out):
                raise Exception(f"NetCDF file {nc_out} was not created")

            if len(model.results.dims) == 0:
                raise InfeasibleModelException("Model was unfeasible")

            inter_logs.info("Successfully completed scenario_B (single)")

        except Exception as e:
            inter_logs.error(f"file error: {e}")
            inter_logs.error(traceback.format_exc())
            inter_logs.info("Analysing error with Gurobi...")
            if not os.path.exists(lp_file):
                inter_logs.error(f"LP file {lp_file} does not exist, cannot run Gurobi")
                raise
            cmd = ["gurobi_cl", f"ResultFile={results_ilp}", lp_file]
            subprocess.run(cmd, capture_output=True, text=True, check=True)
            inter_logs.info(f"Gurobi report at {results_ilp}")
            os.makedirs(os.path.dirname(done_marker), exist_ok=True)
            with open(done_marker, 'w') as f:
                f.write("completed_with_gurobi_fallback")


