rule scenario_D_single:
    input:
        model_config="model.yaml",
        overrides='overrides.yaml',
        math_file= "math.yaml"
    output:
        nc="results/results_test_scenario_D.nc",
        done="results/results_test_scenario_D.done"
    run:
        inter_logs.info("--- Running scenario_D (single) ---")
        nc_out = output.nc
        done_marker = output.done
        csv_folder = f"results/results_test_scenario_E_csv"
        lp_file = f"results/my_model_D.lp"
        results_ilp = f"results/my_model_D.ilp"

        from Scripts.functions_scenarios import create_scenario_D
        # create scenario_D using provided math.yaml and overrides
        create_scenario_D(input.math_file,
        input.overrides,
        expand_costs=False)

        try:
            model = calliope.examples.spanish_model(
                filename=input.model_config,
                scenario="scenario_D"   # no cost suffix
            )
            model.build()
            model.backend.verbose_strings()
            model.backend.to_lp(lp_file)
            #restore_european_capacity('math.yaml')  # Set back again the constraint modified by create_scenario_D to False
            model.solve()
            model.to_netcdf(nc_out)
            model.to_csv(csv_folder, allow_overwrite=True)

            os.makedirs(os.path.dirname(done_marker), exist_ok=True)
            with open(done_marker, 'w') as f:
                f.write("completed")


            if not os.path.exists(nc_out):
                raise Exception(f"NetCDF file {nc_out} was not created")

            if len(model.results.dims) == 0:
                raise InfeasibleModelException("Model was unfeasible")

            inter_logs.info("Successfully completed scenario_D (single)")

        except Exception as e:
            inter_logs.error(f"file error: {e}")
            inter_logs.error(traceback.format_exc())
            inter_logs.info("Analysing error with Gurobi...")
            if not os.path.exists(lp_file):
                inter_logs.error(f"LP file {lp_file} does not exist, cannot run Gurobi")
                raise
            cmd = ["gurobi_cl", f"ResultFile={results_ilp}", lp_file]
            subprocess.run(cmd, capture_output=True, text=True, check=True)
            inter_logs.info(f"Gurobi report at {results_ilp}")
            os.makedirs(os.path.dirname(done_marker), exist_ok=True)
            with open(done_marker, 'w') as f:
                f.write("completed_with_gurobi_fallback")

rule scenario_E_single:
    input:
        model_config="model.yaml",
        overrides='overrides.yaml',
        math_file = "math.yaml"
    output:
        nc="results/results_test_scenario_E.nc",
        done="results/results_test_scenario_E.done"
    run:
        inter_logs.info("--- Running scenario_E (single) ---")
        nc_out = output.nc
        done_marker = output.done
        csv_folder = f"results/results_test_scenario_E_csv"
        lp_file = f"results/my_model_E.lp"
        results_ilp = f"results/my_model_E.ilp"

        # path to the existing scenario A result (we don't declare it as an input to avoid forcing A)
        results_A_path = "results/results_test_scenario_A.nc"

        # sanity check: require that the A .nc exists (fail early with a clear message)
        if not os.path.exists(results_A_path):
            raise FileNotFoundError(
                f"Required result from scenario A not found at {results_A_path}. "
                "Place the file there or run scenario_A first."
            )

        # create scenario_E using provided overrides/math
        create_scenario_E(override_yaml=input.overrides, expand_costs=False)

        try:
            model = calliope.examples.spanish_model(
                filename=input.model_config,
                scenario="scenario_E"  # no cost suffix
            )
            model.build()
            model.backend.verbose_strings()
            model.backend.to_lp(lp_file)
            restore_european_capacity('math.yaml')  # Set back again the constraint modified by create_scenario_D to False
            inter_logs.info("RUNNING UPDATED SCENARIO E")
            model.solve()
            model.to_netcdf(nc_out)
            model.to_csv(csv_folder,allow_overwrite=True)

            os.makedirs(os.path.dirname(done_marker),exist_ok=True)
            with open(done_marker,'w') as f:
                f.write("completed")

            if not os.path.exists(nc_out):
                raise Exception(f"NetCDF file {nc_out} was not created")

            if len(model.results.dims) == 0:
                raise InfeasibleModelException("Model was unfeasible")

            inter_logs.info("Successfully completed scenario_E (single)")

        except Exception as e:
            inter_logs.error(f"file error: {e}")
            inter_logs.error(traceback.format_exc())
            inter_logs.info("Analysing error with Gurobi...")
            if not os.path.exists(lp_file):
                inter_logs.error(f"LP file {lp_file} does not exist, cannot run Gurobi")
                raise
            cmd = ["gurobi_cl", f"ResultFile={results_ilp}", lp_file]
            subprocess.run(cmd,capture_output=True,text=True,check=True)
            inter_logs.info(f"Gurobi report at {results_ilp}")
            os.makedirs(os.path.dirname(done_marker),exist_ok=True)
            with open(done_marker,'w') as f:
                f.write("completed_with_gurobi_fallback")
